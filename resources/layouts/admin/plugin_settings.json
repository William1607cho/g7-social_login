{
    "version": "1.0.0",
    "layout_name": "plugin_settings",
    "permissions": [
        "core.plugins.update"
    ],
    "extends": "_admin_base",
    "meta": {
        "title": "$t:g7-social_login.settings.page_title",
        "description": "$t:g7-social_login.settings.page_description"
    },
    "data_sources": [
        {
            "id": "settings",
            "label_key": "$t:editor.data_source.settings",
            "type": "api",
            "endpoint": "/api/admin/plugins/{{route.identifier}}/settings",
            "method": "GET",
            "auto_fetch": true,
            "auth_required": true,
            "initLocal": "form",
            "refetchOnMount": true
        }
    ],
    "slots": {
        "content": [
            {
                "id": "plugin_settings_content",
                "type": "basic",
                "name": "Div",
                "dataKey": "form",
                "trackChanges": true,
                "props": {
                    "className": "admin-page-content-responsive"
                },
                "children": [
                    {
                        "id": "page_header",
                        "type": "composite",
                        "name": "PageHeader",
                        "props": {
                            "title": "$t:g7-social_login.settings.page_title",
                            "description": "$t:g7-social_login.settings.page_description",
                            "backPath": "/admin/plugins",
                            "backLabel": "$t:admin.plugins.back_to_list"
                        }
                    },
                    {
                        "id": "notice_banner",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "alert-info" },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": { "className": "flex gap-3" },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": { "name": "circle-info", "className": "text-xl text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "P",
                                        "props": { "className": "text-info-soft" },
                                        "text": "$t:g7-social_login.settings.notice"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "validation_error",
                        "type": "basic",
                        "name": "Div",
                        "if": "{{_local.errors}}",
                        "props": { "className": "alert-danger" },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": { "className": "flex gap-3" },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": { "name": "triangle-exclamation", "className": "text-xl text-red-600 dark:text-red-400 flex-shrink-0 mt-0.5" }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": { "className": "text-error-strong" },
                                                "text": "$t:admin.plugins.settings.validation_error"
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Ul",
                                                "if": "{{typeof _local.errors === 'object' && Object.keys(_local.errors).length > 0}}",
                                                "props": { "className": "mt-2 list-disc list-inside space-y-1" },
                                                "iteration": {
                                                    "source": "Object.entries(_local.errors ?? {}).flatMap(([field, messages]) => Array.isArray(messages) ? messages : [messages])",
                                                    "item_var": "message"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Li",
                                                        "props": { "className": "grid-3col-responsive" },
                                                        "text": "{{message}}"
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "settings_form",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "mt-6 bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700" },
                        "children": [
                            {
                                "id": "settings_fields",
                                "type": "basic",
                                "name": "Div",
                                "props": { "className": "p-6 space-y-8" },
                                "children": [
                                    {
                                        "id": "kakao_section",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": { "className": "space-y-4" },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": { "className": "section-heading" },
                                                "text": "$t:g7-social_login.settings.kakao_section_title"
                                            },
                                            {
                                                "id": "field_kakao_enabled",
                                                "type": "basic",
                                                "name": "Label",
                                                "props": { "className": "flex items-center gap-2 cursor-pointer text-sm text-gray-700 dark:text-gray-300" },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Checkbox",
                                                        "props": { "name": "kakao_enabled" }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:g7-social_login.settings.kakao_enabled.label"
                                                    }
                                                ]
                                            },
                                            {
                                                "id": "field_kakao_client_id",
                                                "type": "basic",
                                                "name": "Div",
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": { "className": "form-label" },
                                                        "text": "$t:g7-social_login.settings.kakao_client_id.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": { "className": "form-hint" },
                                                        "text": "$t:g7-social_login.settings.kakao_client_id.hint"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "text",
                                                            "name": "kakao_client_id",
                                                            "className": "mt-1 focus:border-transparent"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "id": "field_kakao_client_secret",
                                                "type": "basic",
                                                "name": "Div",
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": { "className": "form-label" },
                                                        "text": "$t:g7-social_login.settings.kakao_client_secret.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": { "className": "form-hint" },
                                                        "text": "$t:g7-social_login.settings.kakao_client_secret.hint"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "kakao_client_secret",
                                                            "placeholder": "••••••••••••",
                                                            "className": "mt-1 font-mono text-sm focus:border-transparent"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "id": "google_section",
                                        "type": "basic",
                                        "name": "Div",
                                        "props": { "className": "space-y-4 pt-6 border-t border-gray-200 dark:border-gray-700" },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "H3",
                                                "props": { "className": "section-heading" },
                                                "text": "$t:g7-social_login.settings.google_section_title"
                                            },
                                            {
                                                "id": "field_google_enabled",
                                                "type": "basic",
                                                "name": "Label",
                                                "props": { "className": "flex items-center gap-2 cursor-pointer text-sm text-gray-700 dark:text-gray-300" },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Checkbox",
                                                        "props": { "name": "google_enabled" }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "text": "$t:g7-social_login.settings.google_enabled.label"
                                                    }
                                                ]
                                            },
                                            {
                                                "id": "field_google_client_id",
                                                "type": "basic",
                                                "name": "Div",
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": { "className": "form-label" },
                                                        "text": "$t:g7-social_login.settings.google_client_id.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": { "className": "form-hint" },
                                                        "text": "$t:g7-social_login.settings.google_client_id.hint"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "text",
                                                            "name": "google_client_id",
                                                            "className": "mt-1 focus:border-transparent"
                                                        }
                                                    }
                                                ]
                                            },
                                            {
                                                "id": "field_google_client_secret",
                                                "type": "basic",
                                                "name": "Div",
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Label",
                                                        "props": { "className": "form-label" },
                                                        "text": "$t:g7-social_login.settings.google_client_secret.label"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": { "className": "form-hint" },
                                                        "text": "$t:g7-social_login.settings.google_client_secret.hint"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Input",
                                                        "props": {
                                                            "type": "password",
                                                            "name": "google_client_secret",
                                                            "placeholder": "••••••••••••",
                                                            "className": "mt-1 font-mono text-sm focus:border-transparent"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "guide_section",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "mt-6 bg-gray-50 dark:bg-gray-800/50 rounded-lg border border-gray-200 dark:border-gray-700 p-6" },
                        "children": [
                            {
                                "type": "basic",
                                "name": "H3",
                                "props": { "className": "section-heading mb-4" },
                                "text": "$t:g7-social_login.settings.guide_title"
                            },
                            {
                                "type": "basic",
                                "name": "Ol",
                                "props": { "className": "list-decimal list-inside space-y-3" },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": { "className": "text-label" },
                                        "text": "$t:g7-social_login.settings.guide_item_1"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": { "className": "text-label" },
                                        "text": "$t:g7-social_login.settings.guide_item_2"
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Li",
                                        "props": { "className": "text-label" },
                                        "text": "$t:g7-social_login.settings.guide_item_3"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "footer_buttons",
                        "type": "basic",
                        "name": "Div",
                        "props": { "className": "sticky-footer-buttons" },
                        "children": [
                            {
                                "id": "cancel_button",
                                "type": "basic",
                                "name": "Button",
                                "props": { "className": "btn btn-secondary" },
                                "actions": [
                                    { "type": "click", "handler": "navigate", "params": { "path": "/admin/plugins" } }
                                ],
                                "children": [
                                    { "type": "basic", "name": "Span", "text": "$t:common.cancel" }
                                ]
                            },
                            {
                                "id": "save_button",
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "disabled": "{{!_local.hasChanges || _local.isSaving}}",
                                    "className": "btn btn-primary flex-center gap-1.5"
                                },
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "sequence",
                                        "actions": [
                                            {
                                                "handler": "setState",
                                                "params": { "target": "local", "isSaving": true, "errors": null }
                                            },
                                            {
                                                "handler": "apiCall",
                                                "auth_required": true,
                                                "target": "/api/admin/plugins/{{route.identifier}}/settings",
                                                "params": { "method": "PUT", "body": "{{_local.form}}" },
                                                "onSuccess": [
                                                    {
                                                        "handler": "setState",
                                                        "params": { "target": "local", "isSaving": false, "hasChanges": false }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": { "type": "success", "message": "$t:admin.plugins.settings.save_success" }
                                                    },
                                                    {
                                                        "handler": "refetchDataSource",
                                                        "params": { "dataSourceId": "settings" }
                                                    }
                                                ],
                                                "onError": [
                                                    {
                                                        "handler": "setState",
                                                        "params": { "target": "local", "isSaving": false, "errors": "{{error.errors}}" }
                                                    },
                                                    {
                                                        "handler": "toast",
                                                        "params": { "type": "error", "message": "{{error.message ?? '$t:admin.plugins.settings.save_error'}}" }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "children": [
                                    { "type": "basic", "name": "Icon", "if": "{{_local.isSaving}}", "props": { "name": "spinner", "className": "spinner-sm" } },
                                    { "type": "basic", "name": "Span", "if": "{{!_local.isSaving}}", "text": "$t:common.save" },
                                    { "type": "basic", "name": "Span", "if": "{{_local.isSaving}}", "text": "$t:common.saving" }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
    "pageConfig": {
        "notice": "$t:g7-social_login.settings.notice",
        "guide": {
            "title": "$t:g7-social_login.settings.guide_title",
            "steps": [
                "$t:g7-social_login.settings.guide_item_1",
                "$t:g7-social_login.settings.guide_item_2",
                "$t:g7-social_login.settings.guide_item_3"
            ]
        }
    },
    "schema": {
        "kakao_enabled": {
            "type": "boolean",
            "default": false,
            "label": "$t:g7-social_login.settings.kakao_enabled.label",
            "hint": "$t:g7-social_login.settings.kakao_enabled.hint"
        },
        "kakao_client_id": {
            "type": "string",
            "default": "",
            "label": "$t:g7-social_login.settings.kakao_client_id.label",
            "hint": "$t:g7-social_login.settings.kakao_client_id.hint"
        },
        "kakao_client_secret": {
            "type": "string",
            "default": "",
            "sensitive": true,
            "label": "$t:g7-social_login.settings.kakao_client_secret.label",
            "hint": "$t:g7-social_login.settings.kakao_client_secret.hint"
        },
        "google_enabled": {
            "type": "boolean",
            "default": false,
            "label": "$t:g7-social_login.settings.google_enabled.label",
            "hint": "$t:g7-social_login.settings.google_enabled.hint"
        },
        "google_client_id": {
            "type": "string",
            "default": "",
            "label": "$t:g7-social_login.settings.google_client_id.label",
            "hint": "$t:g7-social_login.settings.google_client_id.hint"
        },
        "google_client_secret": {
            "type": "string",
            "default": "",
            "sensitive": true,
            "label": "$t:g7-social_login.settings.google_client_secret.label",
            "hint": "$t:g7-social_login.settings.google_client_secret.hint"
        }
    }
}
